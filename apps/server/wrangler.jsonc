// Konfiguration für Cloudflare (Wrangler). Lokal: `corepack pnpm --filter @brett-und-blatt/server dev`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brett-und-blatt",
  // Cloudflare-Konto von Cornelius (nicht geheim; erspart der CI ein zweites Secret).
  "account_id": "edce5b79ce86adb04d7e64f0f41c44d2",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "LOBBY_REGISTRY", "class_name": "LobbyRegistry" },
      { "name": "BACKUPS", "class_name": "BackupVault" },
      { "name": "TOURNAMENTS", "class_name": "TournamentRoom" },
      { "name": "ATTEMPTS", "class_name": "AttemptLimiter" },
      { "name": "PASS_LOCKS", "class_name": "PassLock" },
      { "name": "SHARES", "class_name": "PassShare" },
      { "name": "CLASSES", "class_name": "ClassRoom" },
      { "name": "SERIES", "class_name": "SeriesRoom" },
      { "name": "ORGS", "class_name": "OrgRoom" },
      { "name": "ORG_DESK", "class_name": "OrgDesk" },
      { "name": "ACCOUNT_FLOWS", "class_name": "AccountFlow" },
      { "name": "ACCOUNT_LOCKS", "class_name": "AccountLockBox" },
      { "name": "PACKAGE_SHARES", "class_name": "PackageShare" }
    ]
  },
  // Geteilte Anki-Pakete mit Medien (#101, L7): verschlüsselte Bytes, Rechtsraum EU (nachträglich nicht änderbar).
  "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "anki-brett-blatt", "jurisdiction": "eu" }],
  // Im Gratis-Tarif gibt es nur Durable Objects mit SQLite-Speicher.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyRegistry"] },
    { "tag": "v3", "new_sqlite_classes": ["BackupVault"] },
    { "tag": "v4", "new_sqlite_classes": ["TournamentRoom"] },
    { "tag": "v5", "new_sqlite_classes": ["AttemptLimiter"] },
    { "tag": "v6", "new_sqlite_classes": ["PassLock"] },
    { "tag": "v7", "new_sqlite_classes": ["PassShare"] },
    { "tag": "v8", "new_sqlite_classes": ["ClassRoom"] },
    { "tag": "v9", "new_sqlite_classes": ["SeriesRoom"] },
    { "tag": "v10", "new_sqlite_classes": ["AccountFlow", "AccountLockBox"] },
    { "tag": "v11", "new_sqlite_classes": ["OrgRoom", "OrgDesk"] },
    { "tag": "v12", "new_sqlite_classes": ["PackageShare"] }
  ],
  "vars": {
    // Von diesen Seiten aus dürfen Räume erstellt und betreten werden – nur die echten Adressen (#322).
    // Die lokalen Adressen (Vite 5173/4173, VR-App 5175/4175) setzt nur der lokale Server: `dev` in package.json.
    "ALLOWED_ORIGINS": "https://spiele.lipponer.de,https://vr.spiele.lipponer.de,https://brett-und-blatt-vr.pages.dev",
    // Räume liegen in der EU. Der lokale Testserver kann das nicht und überschreibt es mit "none".
    "ROOM_JURISDICTION": "eu"
    // Web Push (#242): VAPID_PUBLIC_KEY und VAPID_SUBJECT setzt die CI aus den GitHub-Variablen gleichen Namens, der private
    // Schlüssel VAPID_PRIVATE_KEY ist ein Wrangler-Secret. Fehlt einer, ignoriert der Server Abos. Siehe docs/spiele/web-push.md.
  }
}
