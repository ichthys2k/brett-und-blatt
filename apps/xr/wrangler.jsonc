// Brett & Blatt VR (#339): nur statische Dateien, ausgeliefert von Cloudflare. Veröffentlicht die CI
// nach „deploy“ (Job „VR-App auf Cloudflare veröffentlichen“); von Hand:
//   corepack pnpm --filter @brett-und-blatt/xr build && corepack pnpm --filter @brett-und-blatt/xr run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brett-und-blatt-xr",
  // Cloudflare-Konto von Cornelius (wie beim Spieleserver, nicht geheim).
  "account_id": "edce5b79ce86adb04d7e64f0f41c44d2",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unbekannte Pfade liefern die App aus; Raumcodes stehen ohnehin hinter „#“.
    "not_found_handling": "single-page-application"
  },
  // Erreichbar unter https://brett-und-blatt-xr.lipponer.workers.dev und der eigenen Unterdomain.
  // Die Unterdomain legt Cloudflare samt DNS-Eintrag und Zertifikat selbst an (Zone lipponer.de liegt dort).
  "workers_dev": true,
  "routes": [{ "pattern": "vr.spiele.lipponer.de", "custom_domain": true }]
}
