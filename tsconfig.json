{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "packages/engine/src",
    "packages/engine/test",
    "packages/ui/src",
    "packages/online/src",
    "packages/online/test",
    "packages/games/*/src",
    "packages/games/*/test",
    "apps/web/src"
  ]
}
